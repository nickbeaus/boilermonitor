# Boiler monitor configuration
# Copy to .env and fill in:   cp .env.example .env && chmod 600 .env
# Format: KEY=VALUE, one per line. Comments only on their own line (no
# inline comments). Quote values containing spaces. Lists are comma-separated.
# This file is also read by systemd (EnvironmentFile), so keep that format.

# ---- Notification channels (true/false) -------------------------------------
SMS_ENABLED=true
CALLS_ENABLED=true

# ---- PLC (CLICK PLUS, Modbus TCP) -------------------------------------------
# Use 127.0.0.1 / 5020 to test against fake_plc.py
PLC_HOST=192.0.2.10
PLC_PORT=502
POLL_SECONDS=1.0
# PLC unreachable this many seconds -> comms-lost alert
COMMS_ALERT_AFTER_SECONDS=60

# ---- voip.ms SMS ---------------------------------------------------------------
# API password is set under Main Menu > SOAP and REST/JSON API (not your portal password)
VOIPMS_API_USERNAME=you@example.org
VOIPMS_API_PASSWORD=change-me
# SMS-enabled DID the texts come from, 10 digits
VOIPMS_DID=5555550100
SMS_TIMEOUT_SECONDS=45

# ---- FreePBX / Asterisk AMI ------------------------------------------------------
# 127.0.0.1 when using the SSH tunnel (systemd/boilermonitor-tunnel.service)
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USERNAME=boilermonitor
AMI_SECRET=change-me
CALLERID_NAME="Boiler Alarm"
CALLERID_NUM=900
CALL_RING_SECONDS=30

# ---- SSH tunnel to the PBX (used only by boilermonitor-tunnel.service) -----
PBX_SSH_TARGET=root@192.0.2.20
PBX_SSH_KEY=/home/youruser/.ssh/pbx_tunnel

# ---- Repeat suppression ------------------------------------------------------
# false = send every event immediately
COOLDOWNS_ENABLED=true
DEFAULT_COOLDOWN_SECONDS=300

# ---- Logging ---------------------------------------------------------------------
# DEBUG, INFO, WARNING
LOG_LEVEL=INFO
# Optional rotating log file (5 MB x 5). Leave empty for console/journal only.
LOG_FILE=

# ---- Comms lost / restored (detected by the bridge, not the PLC) -------------
# Calls go out on comms LOST only; restored is text only.
COMMS_SMS=5555550123
COMMS_EXTENSIONS=1001
COMMS_RECORDING=custom/plc-comms-lost
COMMS_LOST_MESSAGE="BOILER MONITOR: Lost communication with boiler PLC. Pressure is NOT being monitored. Check PLC power/WiFi."
COMMS_RESTORED_MESSAGE="BOILER MONITOR: Communication with boiler PLC restored. Monitoring resumed."

# ---- Alarms ----------------------------------------------------------------------
# Numbered ALARM_1_, ALARM_2_, ... ; numbering must be continuous.
#   NAME        label for logs, must be unique
#   GROUP       events in the same group supersede each other (stale ones dropped)
#   COIL        CLICK C-bit the PLC latches (1 = C1)
#   ACK_COIL    C-bit the bridge sets after notifying; PLC then resets both
#   COOLDOWN    optional, seconds; overrides DEFAULT_COOLDOWN_SECONDS
#   MESSAGE     SMS text, 160 chars max
#   SMS         cell numbers, 10 digits, comma-separated
#   EXTENSIONS  FreePBX extensions, each called independently (empty = no calls)
#   RECORDING   System Recording played when answered

ALARM_1_NAME="Pressure LOW"
ALARM_1_GROUP=pressure
ALARM_1_COIL=1
ALARM_1_ACK_COIL=101
ALARM_1_MESSAGE="BOILER ALARM: Boiler pressure LOW. Check boiler room immediately."
ALARM_1_SMS=5555550123
ALARM_1_EXTENSIONS=1001,1002
ALARM_1_RECORDING=custom/pressure-low

ALARM_2_NAME="Pressure NORMAL"
ALARM_2_GROUP=pressure
ALARM_2_COIL=2
ALARM_2_ACK_COIL=102
ALARM_2_COOLDOWN=60
ALARM_2_MESSAGE="BOILER OK: Boiler pressure returned to NORMAL."
ALARM_2_SMS=5555550123
ALARM_2_EXTENSIONS=1001,1002
ALARM_2_RECORDING=custom/pressure-normal
